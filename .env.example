# =============================================================================
# AURA TECH Backend — Environment Configuration Template
# =============================================================================
# Copy to .env on the Hetzner server:
#   cp .env.example .env && nano .env
#
# NEVER commit .env to git.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
# production on Hetzner | development locally
NODE_ENV=production

# Internal container port (docker-compose sets 5000; host maps 3000:5000)
PORT=5000

# Public API URL (Cloudflare / custom domain)
API_URL=https://api.auratechplus.com

# Frontend origin (no trailing slash)
CORS_ORIGIN=https://www.auratechplus.com

# ─── PostgreSQL (Docker service: postgres) ───────────────────────────────────
# Do NOT expose Postgres port 5432 publicly — internal Docker network only.
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32
DB_NAME=auratech_db
DB_POOL_SIZE=10

# Optional single connection string (auto-set in docker-compose.yml)
# DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/auratech_db

# ─── Redis (Docker service: redis) ───────────────────────────────────────────
# Internal only — no password required inside private Docker network.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional single connection string (auto-set in docker-compose.yml)
# REDIS_URL=redis://redis:6379

# ─── Authentication (JWT) ───────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_minimum_32_characters_required
JWT_EXPIRY=24h

# ─── Verification codes ─────────────────────────────────────────────────────
VERIFICATION_CODE_EXPIRY=15
RESET_CODE_EXPIRY=30
CODE_ATTEMPTS=3

# ─── Cloudinary (product images, logos) ─────────────────────────────────────
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email — Brevo (primary, used by emailService.ts) ───────────────────────
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@auratechplus.com
ADMIN_EMAIL=admin@auratechplus.com

# ─── Email — SendGrid (optional, dependency present, not primary) ───────────
# Only needed if you switch mail provider to SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ─── Firebase Admin (push notifications — optional) ─────────────────────────
# Production/Docker: paste entire service account JSON on ONE line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
# Local dev alternative: mount JSON file and set path
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# ─── Google Gemini (SMS payment parsing fallback) ────────────────────────────
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ─── Payment auto-verification ───────────────────────────────────────────────
# PAYMENT_VERIFY_TTL_SEC=3600

# ─── App ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=10

# =============================================================================
# .env.production (DO NOT commit — create manually on server)
# =============================================================================
# On Hetzner after setup-hetzner.sh:
#   1. cp .env.example .env
#   2. Set DB_PASSWORD, JWT_SECRET, BREVO_*, CLOUDINARY_*, FIREBASE_* 
#   3. Confirm API_URL=https://api.auratechplus.com
#   4. Confirm CORS_ORIGIN=https://www.auratechplus.com
#   5. docker compose up -d --build
# =============================================================================
