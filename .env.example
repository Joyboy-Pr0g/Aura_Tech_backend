# ─── Local development ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# ─── Database (local: separate vars | Render: use DATABASE_URL) ─────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_NAME=aura_tech
DB_POOL_SIZE=10
# DATABASE_URL=postgresql://user:pass@host:5432/aura_tech

# ─── Redis (local: separate vars | Render: use REDIS_URL) ───────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://:password@host:6379

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRY=24h

# ─── Verification codes ─────────────────────────────────────────────────────
VERIFICATION_CODE_EXPIRY=15
RESET_CODE_EXPIRY=30
CODE_ATTEMPTS=3

# ─── Cloudinary ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (Brevo) ──────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_FROM_EMAIL=
ADMIN_EMAIL=

# ─── Firebase push (optional) ───────────────────────────────────────────────
# Local dev: path to JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# Render/production: entire JSON on one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── App ───────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=10

# ─── Production example (Render + api.auratechplus.com) ─────────────────────
# NODE_ENV=production
# API_URL=https://api.auratechplus.com
# CORS_ORIGIN=https://www.auratechplus.com
# DATABASE_URL=<from Render Postgres dashboard>
# REDIS_URL=<from Render Key Value dashboard>
# JWT_SECRET=<generate new secret for production>
